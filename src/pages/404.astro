---
import Page from '../layouts/Page.astro';
const base = import.meta.env.BASE_URL;
---
<Page title="Page not found / Страница не найдена" description="Return to the English or Russian profile." noindex>
  <main class="chooser">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p lang="ru">Страница не найдена</p>
    <nav class="chooser-links" aria-label="Profile language / Язык профиля">
      <a href={`${base}en/`} lang="en" hreflang="en" data-language="en">English →</a>
      <a href={`${base}ru/`} lang="ru" hreflang="ru" data-language="ru">Русский →</a>
    </nav>
  </main>
</Page>
